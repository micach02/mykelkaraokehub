# myKelKaraokeHub environment variables
# Copy this file to .env and fill in values. Never commit .env.

# YouTube Data API v3 key. Used only by the karaoke server (it is never sent
# to browsers or phones) to search YouTube for karaoke videos.
# In Google Cloud Console, set the key's "Application restrictions" to None
# and its "API restrictions" to YouTube Data API v3 only.
YOUTUBE_API_KEY=
